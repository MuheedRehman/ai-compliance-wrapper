OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_MODEL=gpt-4.1-nano

# Local dev:
DATABASE_URL=sqlite:///./app/data/app.db

# Postgres/Cloud SQL example:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres
# Cloud Run unix socket example:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@/postgres?host=/cloudsql/PROJECT_ID:REGION:INSTANCE_NAME

APP_ENV=development

# warn / quarantine / block
FEATURE_ID_ENFORCEMENT=warn

# allow_with_warning / quarantine / block
CANDIDATE_VERSION_POLICY=allow_with_warning

# best_effort_tenant_chain is honest for current implementation
EVIDENCE_CHAIN_MODE=best_effort_tenant_chain

EVIDENCE_HMAC_SECRET=replace_with_random_64_char_hex_secret
